# Copia a .env. Reinicia el servidor después de editar.
OLLAMA_HOST=http://127.0.0.1:11434
GHOST_MODEL=ghost-heretic
GHOST_MEMORY_MODEL=ghost-heretic
OLLAMA_API_KEY=
GHOST_API_TOKEN=
GHOST_BIND=127.0.0.1
GHOST_PORT=8000
GHOST_PUBLIC=0
# En público son obligatorios token de al menos 32 caracteres, hosts y orígenes HTTPS.
GHOST_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
GHOST_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
GHOST_ENABLE_SKILLS=0
GHOST_ALLOWED_APPS=calculator,notes
# Vacío: Escritorio, Descargas, Documentos, Música, Imágenes y Películas.
GHOST_SEARCH_ROOT=
GHOST_LEARNING=1
GHOST_WEB_SEARCH=0
# Opcional: ruta absoluta a la carpeta con tus JSON existentes.
# GHOST_DATA_DIR=/ruta/a/tu/memoria

# Alternativa web: API compatible con chat/completions
# GHOST_PROVIDER=openai
# GHOST_API_BASE=https://tu-proveedor.example/v1
# GHOST_API_KEY=

# Skills locales (solo con confirmación) y dictado opt-in
GHOST_ENABLE_WEB=1
GHOST_ENABLE_MIC=0
